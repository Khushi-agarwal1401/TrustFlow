# Database
DATABASE_URL="postgresql://user:password@localhost:5432/trustflow"

# NextAuth
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (used in auth.ts)
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Resend — magic-link auth + transactional email (used in auth.ts + resend.ts)
RESEND_API_KEY="re_xxxxxxxxxxxx"
AUTH_EMAIL_FROM="TrustFlow AI <noreply@trustflow.ai>"

# Stripe (used in stripe.ts + escrow routes)
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"

# Razorpay (used in razorpay.ts)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-secret"

# OpenAI (used in openai.ts — contract generation, scope validation, dispute suggestion)
OPENAI_API_KEY="sk-xxxxxxxxxxxx"

# Redis — BullMQ queues for ai-validation and risk-signal workers (used in queue.ts)
REDIS_URL="redis://localhost:6379"

# Supabase Storage — evidence file uploads (used in supabase-storage.ts)
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# App URL — used in invite link generation (replace-freelancer route)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
